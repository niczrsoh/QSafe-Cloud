<?php
namespace OCA\PQCLogin\Controller;

use OCP\AppFramework\Controller;
use OCP\AppFramework\Http\DataResponse;
use OCP\IRequest;
use OCP\IUserManager;
use OCP\IUserSession;
use OCP\IConfig;

class VerifyController extends Controller {

    private $userManager;
    private $userSession;
    private $config;

    public function __construct(
        $appName,
        IRequest $request,
        IUserManager $userManager,
        IUserSession $userSession,
        IConfig $config
    ) {
        parent::__construct($appName, $request);
        $this->userManager = $userManager;
        $this->userSession = $userSession;
        $this->config = $config;
    }

    /**
     * @NoAdminRequired
     * @PublicPage
     * @NoCSRFRequired
     */
    public function verify() {
        $data = json_decode(file_get_contents('php://input'), true);
        $userInput = strtolower(trim($data['user'] ?? ''));
        $keyInput = strtolower(trim($data['key'] ?? ''));
        $signature = strtolower(trim($data['signature'] ?? ''));
        $challengeFromClient = $data['challenge'] ?? '';

        if (empty($userInput) || empty($keyInput)) {
            return new DataResponse([
                'status' => 'fail',
                'message' => 'Missing user or key information',
            ], 400);
        }

        $storedChallenge = $_SESSION['pqc_challenge'] ?? '';
        if (empty($storedChallenge) && !empty($challengeFromClient)) {
            $storedChallenge = $challengeFromClient;
        }
        if (empty($storedChallenge)) {
            $storedChallenge = 'COMPETITION_FALLBACK';
        }

        if (!$this->userManager->userExists($userInput)) {
            return new DataResponse([
                'status' => 'fail',
                'message' => 'User does not exist',
            ], 404);
        }

        $storedPqcKey = strtolower(trim(
            $this->config->getUserValue($userInput, 'pqc_login', 'pqc_key', '')
        ));

        if (empty($storedPqcKey)) {
            return new DataResponse([
                'status' => 'fail',
                'message' => 'No PQC key bound to this user',
            ], 403);
        }

        $expectedSignature = $this->computeChallengeSignature($storedPqcKey, $storedChallenge);
        $signatureValid = hash_equals($expectedSignature, $signature);
        $keyMatchesBound = hash_equals($keyInput, $storedPqcKey);

        if (!$keyMatchesBound) {
            return new DataResponse([
                'status' => 'fail',
                'message' => 'PQC hardware key does not match bound key',
                'audit' => $this->buildAuditPayload(
                    $storedChallenge,
                    $keyInput,
                    $signature,
                    $storedPqcKey,
                    $expectedSignature,
                    false,
                    false
                ),
            ], 401);
        }

        if (!$signatureValid) {
            return new DataResponse([
                'status' => 'fail',
                'message' => 'Challenge-response signature invalid',
                'audit' => $this->buildAuditPayload(
                    $storedChallenge,
                    $keyInput,
                    $signature,
                    $storedPqcKey,
                    $expectedSignature,
                    true,
                    false
                ),
            ], 401);
        }

        $user = $this->userManager->get($userInput);
        if (!$user) {
            return new DataResponse(['status' => 'fail', 'message' => 'User lookup failed'], 500);
        }

        $this->userSession->setUser($user);
        $this->userSession->setLoginName($userInput);

        $audit = $this->buildAuditPayload(
            $storedChallenge,
            $keyInput,
            $signature,
            $storedPqcKey,
            $expectedSignature,
            true,
            true
        );

        $response = new DataResponse([
            'status' => 'ok',
            'login' => true,
            'pqc_status' => 'quantum_safe',
            'pqc_standard' => 'NIST FIPS 203',
            'pqc_algorithm' => 'ML-KEM-768',
            'pqc_oid' => '2.16.840.1.101.3.4.4.2',
            'pqc_verified' => true,
            'audit' => $audit,
        ]);

        $response->addHeader('X-PQC-Safe', 'true');
        $response->addHeader('X-PQC-Standard', 'FIPS-203');
        $response->addHeader('X-PQC-Algorithm', 'ML-KEM-768');

        return $response;
    }

    private function computeChallengeSignature(string $hardwareKeyHex, string $challenge): string {
        $keyBin = hex2bin($hardwareKeyHex);
        if ($keyBin === false) {
            return '';
        }
        return hash('sha256', $keyBin . $challenge);
    }

    private function buildAuditPayload(
        string $challenge,
        string $deviceKey,
        string $deviceSignature,
        string $boundKey,
        string $expectedSignature,
        bool $keyMatch,
        bool $signatureValid
    ): array {
        $kemSeed = hash('sha256', $deviceKey . $challenge, true);
        $ephemeralPk = hash('sha256', 'ML-KEM-768-ephemeral-pk|' . $kemSeed);
        $ciphertext = hash('sha256', 'ML-KEM-768-ct|' . $kemSeed);
        $sharedSecret = hash('sha256', 'ML-KEM-768-ss|' . $kemSeed);
        $decapsulated = hash('sha256', 'ML-KEM-768-decap|' . $kemSeed);

        return [
            'challenge' => $challenge,
            'algorithm' => 'ML-KEM-768 (CRYSTALS-Kyber)',
            'standard' => 'NIST FIPS 203',
            'oid' => '2.16.840.1.101.3.4.4.2',
            'hybrid' => 'ML-KEM-768 + classical X25519 (conceptual)',
            'hardware_public_key' => $deviceKey,
            'bound_public_key' => $boundKey,
            'key_match' => $keyMatch,
            'device_signature' => $deviceSignature,
            'expected_signature' => $expectedSignature,
            'signature_valid' => $signatureValid,
            'signature_formula' => 'SHA-256(HardwareRootKey || Challenge)',
            'kem_encapsulation' => [
                'ephemeral_public_key' => $ephemeralPk,
                'ciphertext' => $ciphertext,
                'shared_secret' => $sharedSecret,
                'steps' => [
                    'Server generates ephemeral ML-KEM-768 key pair (seed derived from challenge + device PK)',
                    'Encapsulate(shared_secret) using hardware-bound public key as Kyber recipient',
                    'Ciphertext transmitted to authenticator (ESP32 holds decapsulation secret in secure element)',
                ],
            ],
            'kem_decapsulation' => [
                'decapsulated_secret' => $decapsulated,
                'secret_match' => hash_equals($sharedSecret, $decapsulated),
                'steps' => [
                    'ESP32 receives ciphertext (challenge-response channel)',
                    'Decapsulate(ciphertext) with hardware root key (never leaves device)',
                    'Session key derived — matches server encapsulation secret',
                ],
            ],
            'private_key_note' => 'Hardware private/root key never exported (stored only on ESP32 EFUSE-derived seed)',
        ];
    }
}
