                    <div style="margin-top:6px;color:#4ade80;font-weight:bold;">Shared secret match: ${decapOk}</div>
                    <ul style="margin:8px 0 0;padding-left:18px;color:#94a3b8;font-size:10px;line-height:1.6;">
                        ${(dec.steps || []).map((s) => `<li>${escHtml(s)}</li>`).join("")}
                    </ul>
                </div>
            </div>

            <button id="pqc-confirm-enter" type="button" style="
                margin-top:18px;width:100%;padding:16px;border:none;border-radius:12px;
                background:linear-gradient(135deg,#16a34a,#15803d);color:white;
                font-size:16px;font-weight:700;cursor:pointer;
                box-shadow:0 8px 24px rgba(22,163,74,0.35);
            ">
                ✓ Confirm & Enter Dashboard
            </button>
            <p style="margin-top:10px;font-size:11px;color:#64748b;text-align:center;">
                Review the evidence above, then confirm to complete login.
            </p>
        </div>
    `;

    const btnLabel = audit.signature_valid && audit.key_match
        ? "✓ Confirm & Enter Dashboard"
        : "Close (verification failed)";

    const btn = document.getElementById("pqc-confirm-enter");
    if (btn) {
        btn.textContent = btnLabel;
        if (!audit.signature_valid || !audit.key_match) {
            btn.style.background = "linear-gradient(135deg,#475569,#334155)";
        }
    }

    return new Promise((resolve) => {
        if (!btn) {
            resolve(false);
            return;
        }

        btn.addEventListener("click", async () => {
            if (!audit.signature_valid || !audit.key_match) {
                resolve(false);
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:center;gap:10px;">
                    <div class="pqc-spinner"></div>
                    <span>Signing in to QSafe Cloud...</span>
                </div>
            `;
            resolve(true);
        }, { once: true });
    });
}


// ==============================
// ❌ ERROR
// ==============================
function showPQCError(text) {

    const status =
        document.getElementById("status");

    if (!status) return;

    status.innerHTML = `
        <div style="
            display:flex;
            align-items:center;
            justify-content:center;
            gap:10px;
            color:#dc2626;
            font-weight:600;
        ">
            <span style="font-size:18px;">
                ❌
            </span>

            <span>${text}</span>
        </div>
    `;
}


// ==============================
// 🔌 CONNECT ESP32
// ==============================
async function connectESP32() {

    try {

        updatePQCStatus(
            "Fetching PQC challenge..."
        );

        // ==============================
        // 1. GET CHALLENGE FROM SERVER
        // ==============================
        const challengeRes = await fetch(apiUrl('/apps/pqc_login/challenge'));
        const challengeData = await challengeRes.json();
        const challenge = challengeData.challenge;

        if (!challenge) {
            throw new Error("Failed to get PQC challenge from server");
        }

        console.log("CHALLENGE RECEIVED:", challenge);

        updatePQCStatus(
            "Waiting for secure device..."
        );

        // ==============================
        // CLEAN OLD PORT
        // ==============================
        if (activePort) {

            try {

                await activePort.close();

            } catch(e) {}

            activePort = null;
        }

        console.log("CONNECTING TO ESP32...");

        // ==============================
        // REQUEST PORT
        // ==============================
        try {
            activePort = await navigator.serial.requestPort();
        } catch (portErr) {
            console.warn("PORT SELECTION CANCELLED:", portErr);
            if (portErr.name === "NotFoundError") {
                showPQCError("No device selected. Please click 'Connect' and select your ESP32.");
            } else {
                showPQCError("Connection failed: " + portErr.message);
            }
            return;
        }

        updatePQCStatus(
            "Opening secure channel..."
        );

        // ==============================
        // OPEN SERIAL
        // ==============================
        await activePort.open({
            baudRate:115200
        });

        console.log(
            "SERIAL OPEN SUCCESS"
        );

        updatePQCStatus(
            "Sending challenge to PQC module..."
        );

        // ==============================
        // WAIT BOOT
        // ==============================
        await new Promise(resolve =>
            setTimeout(resolve, 1500)
        );

        // ==============================
        // SEND CHALLENGE TO ESP32
        // ==============================
        const encoder =
            new TextEncoder();

        const writer =
            activePort.writable.getWriter();

        // Protocol: CHALLENGE:<data>\n
        await writer.write(
            encoder.encode(`CHALLENGE:${challenge}\n`)
        );

        writer.releaseLock();

        console.log("CHALLENGE SENT TO ESP32");

        // ==============================
        // READ RESPONSE (SIGNED CHALLENGE)
        // ==============================
        const reader =
            activePort.readable.getReader();

        const decoder =
            new TextDecoder();

        let buffer = "";
        let key = "";
        let signature = "";

        const timeout = setTimeout(() => {

            console.error(
                "ESP32 TIMEOUT"
            );

            reader.cancel();

        }, 15000);

        while (true) {

            const {
                value,
                done
            } = await reader.read();

            if (done) break;

            const chunk =
                decoder.decode(value);

            console.log("RAW FROM ESP32:", chunk);

            buffer += chunk;

            const parsed = parseEsp32SerialBuffer(buffer);
            key = parsed.key;
            signature = parsed.signature;

            if (key.length === 64 && signature.length === 64) {
                clearTimeout(timeout);
                console.log("PQC KEY:", key, "(" + key.length + ")");
                console.log("PQC SIG:", signature, "(" + signature.length + ")");
                reader.releaseLock();
                break;
            }
        }

        if (key.length !== 64 || signature.length !== 64) {
            throw new Error(
                "Incomplete PQC handshake (PQC_KEY len=" + key.length +
                ", PQC_SIG len=" + signature.length + "; need 64 each)"
            );
        }

        updatePQCStatus(
            "Verifying ML-KEM signature..."
        );

        // ==============================
        // VERIFY BACKEND
        // ==============================
        const response =
            await fetch(
                apiUrl('/apps/pqc_login/verify'),
                {
                    method:'POST',
                    headers:{
                        'Content-Type':
                            'application/json'
                    },
                    body:JSON.stringify({
                        user: window._pqcCred.username,
                        key,
                        signature,
                        challenge
                    })
                }
            );

        if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            if (errData.audit) {
                await showPQCVerificationSteps("Verification failed — review evidence");
                await showPQCEvidenceReport(errData.audit, window._pqcCred.username);
                return;
            }
            throw new Error(errData.message || "Verification failed");
        }

        const data =
            await response.json();

        console.log(
            "VERIFY RESPONSE:",
            data
        );

        // ==============================
        // SUCCESS
        // ==============================
        if (data.status === "ok") {

            await showPQCVerificationSteps(
                "Secure authentication successful"
            );

            let audit = data.audit;
            if (!audit) {
                const expectedSig = await computeChallengeSignature(key, challenge);
                audit = {
                    challenge,
                    algorithm: "ML-KEM-768 (CRYSTALS-Kyber)",
                    standard: "NIST FIPS 203",
                    oid: "2.16.840.1.101.3.4.4.2",
                    hardware_public_key: key,
                    bound_public_key: key,
                    key_match: true,
                    device_signature: signature,
                    expected_signature: expectedSig,
                    signature_valid: signature === expectedSig,
                    signature_formula: "SHA-256(HardwareRootKey || Challenge)",
                    kem_encapsulation: { steps: ["(client-side audit)"] },
                    kem_decapsulation: { steps: ["(client-side audit)"] },
                    private_key_note: "Hardware private key never exported",
                };
            }

            const confirmed = await showPQCEvidenceReport(audit, window._pqcCred.username);

            if (confirmed && audit.signature_valid && audit.key_match) {
                await doRealLogin();
            }

            return;
        }

        throw new Error(
            "Verification failed"
        );

    } catch (err) {

        console.error(
            "VERIFY ERROR:",
            err
        );

        showPQCError(
            err.message
        );

        try {

            if (activePort) {

                await activePort.close();

                activePort = null;
            }

        } catch(e) {}
    }
}


// ==============================
// 🔑 REAL LOGIN
// ==============================
async function doRealLogin() {

    const {
        username,
        password
    } = window._pqcCred || {};

    if (!username || !password) {
        showPQCError("Missing login credentials. Please close and try again.");
        return;
    }

    updatePQCStatus("Signing in to QSafe Cloud...", "#007bff");

    try {

        const token = requestToken();
        if (!token) {
            throw new Error("Missing security token. Please refresh the page.");
        }

        const formData =
            new URLSearchParams();

        formData.append(
            "user",
            username
        );

        formData.append(
            "password",
            password
        );

        formData.append(
            "requesttoken",
            token
        );

        const res = await fetch(
            "/index.php/login",
            {
                method:"POST",
                body:formData,
                credentials:"same-origin",
                redirect: "manual"
            }
        );

        console.log(
            "LOGIN STATUS:",
            res.status
        );

        if (res.status === 0 || res.status === 302 || res.status === 303 || res.ok) {
            updatePQCStatus("Success! Opening dashboard...", "#16a34a");
            window.location.href = "/index.php/apps/files/";
            return;
        }

        throw new Error("Login failed (HTTP " + res.status + "). Please try again.");

    } catch(err) {

        console.error(
            "LOGIN ERROR:",
            err
        );

        showPQCError(err.message || "Login failed. Please try again.");

        const btn = document.getElementById("pqc-confirm-enter");
        if (btn) {
            btn.disabled = false;
            btn.textContent = "✓ Confirm & Enter Dashboard";
        }
    }
}

